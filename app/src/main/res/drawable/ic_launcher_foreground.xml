<?xml version="1.0" encoding="utf-8"?>
<!--
  每日天气 App 图标 v5（对标南风天气参考图）：
  蓝色渐变底 + 左上带光晕的暖黄太阳 + 偏右的多层柔和白云。
  分层（自底向上）：
    1) 云的白色柔光（radial，撑出体积感的光晕）
    2) 云下方柔和投影（radial 深蓝，让云"浮"在背景上）
    3) 太阳光晕（radial 暖黄，外圈淡出成透明）
    4) 太阳核心（radial，内亮外暖黄）
    5) 云主体（多个圆瓣合并成一个剪影，vertical 渐变：上白下浅蓝灰，立体感）
  坐标基于 108 视口，全部落在自适应安全区（中心圆 d66，x/y∈[21,87]）附近。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1) 云体柔光：垫在云后的一圈白色辉光 -->
    <path
        android:pathData="M20,57 a37,32 0 1,0 74,0 a37,32 0 1,0 -74,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="57"
                android:centerY="59"
                android:gradientRadius="33"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- 2) 云下方柔和投影（深蓝，让云有悬浮感） -->
    <path
        android:pathData="M31,71 a27,15 0 1,0 54,0 a27,15 0 1,0 -54,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="58"
                android:centerY="75"
                android:gradientRadius="26"
                android:startColor="#3D183466"
                android:endColor="#00183466" />
        </aapt:attr>
    </path>

    <!-- 3) 太阳光晕（左上，暖黄，外圈淡出） -->
    <path
        android:pathData="M14,38 a23,23 0 1,0 46,0 a23,23 0 1,0 -46,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="37"
                android:centerY="38"
                android:gradientRadius="23"
                android:startColor="#F2FFEC9E"
                android:endColor="#00FFE9A8" />
        </aapt:attr>
    </path>

    <!-- 4) 太阳核心（内亮外暖黄，饱和金黄） -->
    <path
        android:pathData="M24,38 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="35"
                android:gradientRadius="16"
                android:startColor="#FFFCE0"
                android:endColor="#FFCB3D" />
        </aapt:attr>
    </path>

    <!-- 5) 云主体：6 个圆瓣合并成一个剪影，上白下浅蓝灰的立体渐变 -->
    <path
        android:fillType="nonZero"
        android:pathData="
            M40,51 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0
            M31,58 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0
            M58,54 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0
            M36,66 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0
            M47,69 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0
            M59,64 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0
        ">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="34"
                android:endX="54"
                android:endY="82"
                android:startColor="#FFFFFF"
                android:endColor="#CFE0F2" />
        </aapt:attr>
    </path>

</vector>
