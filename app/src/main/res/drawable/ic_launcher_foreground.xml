<?xml version="1.0" encoding="utf-8"?>
<!--
  每日天气 App 图标 v4：浅蓝底 + 白云 + 左上黄太阳
  修复 v3 的"云太大太阳太小不协调"：太阳放大（核心 r13 / 光晕 r18），
  云朵收敛为 5 圆（r10-13）略小、位置偏右托住太阳右下缘，整体缩放 1.18 -> 1.10。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.10"
        android:scaleY="1.10"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 太阳光晕（左上，放大） -->
        <path
            android:fillColor="#FFE9A8"
            android:pathData="M14,32 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />

        <!-- 太阳核心（放大） -->
        <path
            android:fillColor="#FFD54F"
            android:pathData="M19,32 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />

        <!-- 云朵（白色，5 圆略小、偏右，托住太阳右下缘） -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="
                M37,54 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0
                M53,58 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0
                M32,62 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0
                M48,67 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0
                M30,52 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0
            " />
    </group>

</vector>
