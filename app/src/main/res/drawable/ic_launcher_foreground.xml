<?xml version="1.0" encoding="utf-8"?>
<!--
  每日天气 App 图标 v6：
  - 云只占图标上半（y≈27–56），下半留给蓝天留白（v5 云铺满 34–82 显"一整片"）
  - 太阳放大并加双层光晕（外 r30 淡 + 中 r20 暖黄 + 核心 r16），位置左上
  分层（自底向上）：
    1) 云体柔光（radial，撑体积感）
    2) 云下柔和投影（radial 深蓝，悬浮感）
    3) 太阳外层光晕（radial 淡暖，r30）
    4) 太阳中层光晕（radial 暖黄，r20）
    5) 太阳核心（radial 内亮外金黄，r16）
    6) 云主体（4 圆瓣剪影，上白下浅蓝灰渐变）
  坐标基于 108 视口，安全区（中心圆 d66）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1) 云体柔光：垫在云后的一圈白色辉光 -->
    <path
        android:pathData="M33,44 a24,22 0 1,0 48,0 a24,22 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="57"
                android:centerY="44"
                android:gradientRadius="24"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- 2) 云下方柔和投影（深蓝，让云有悬浮感） -->
    <path
        android:pathData="M41,55 a17,9 0 1,0 34,0 a17,9 0 1,0 -34,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="58"
                android:centerY="58"
                android:gradientRadius="17"
                android:startColor="#33183466"
                android:endColor="#00183466" />
        </aapt:attr>
    </path>

    <!-- 3) 太阳外层光晕（淡，撑开体积） -->
    <path
        android:pathData="M5,37 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="37"
                android:gradientRadius="30"
                android:startColor="#66FFF3C0"
                android:endColor="#00FFF3C0" />
        </aapt:attr>
    </path>

    <!-- 4) 太阳中层光晕（暖黄更浓） -->
    <path
        android:pathData="M15,37 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="37"
                android:gradientRadius="20"
                android:startColor="#D9FFE08A"
                android:endColor="#00FFE08A" />
        </aapt:attr>
    </path>

    <!-- 5) 太阳核心（内亮外金黄，比 v5 的 r14 放大到 r16） -->
    <path
        android:pathData="M19,37 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="34"
                android:gradientRadius="18"
                android:startColor="#FFFDF0"
                android:endColor="#FFD24A" />
        </aapt:attr>
    </path>

    <!-- 6) 云主体：4 个圆瓣合并成一个剪影，只占上半（y 27–56），上白下浅蓝灰立体渐变 -->
    <path
        android:fillType="nonZero"
        android:pathData="
            M58,40 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0
            M47,44 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0
            M68,44 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0
            M56,46 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0
        ">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="57"
                android:startY="27"
                android:endX="57"
                android:endY="56"
                android:startColor="#FFFFFF"
                android:endColor="#D9E6F5" />
        </aapt:attr>
    </path>

</vector>
