<?xml version="1.0" encoding="utf-8"?>
<!-- Splash 屏图标：与 App 安装图标 v7 同构图（南风 1:1——深蓝底：云下中 + 太阳左上探出） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1) 云下柔和投影 -->
    <path
        android:pathData="M32,78 a24,10 0 1,0 48,0 a24,10 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="56"
                android:centerY="80"
                android:gradientRadius="24"
                android:startColor="#401B3C6E"
                android:endColor="#001B3C6E" />
        </aapt:attr>
    </path>

    <!-- 2) 太阳外层光晕 -->
    <path
        android:pathData="M-1,38 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="33"
                android:centerY="38"
                android:gradientRadius="34"
                android:startColor="#3DFFF0B8"
                android:endColor="#00FFF0B8" />
        </aapt:attr>
    </path>

    <!-- 3) 太阳中层光晕（白色光晕环） -->
    <path
        android:pathData="M9,38 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="33"
                android:centerY="38"
                android:gradientRadius="24"
                android:startColor="#B3FFFBE8"
                android:endColor="#00FFFBE8" />
        </aapt:attr>
    </path>

    <!-- 4) 太阳核心（放大 r16） -->
    <path
        android:pathData="M17,38 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="34"
                android:gradientRadius="18"
                android:startColor="#FFE98F"
                android:endColor="#FFC43C" />
        </aapt:attr>
    </path>

    <!-- 5) 云体柔光（收小，不洗白背景） -->
    <path
        android:pathData="M36,54 a20,19 0 1,0 40,0 a20,19 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="56"
                android:centerY="54"
                android:gradientRadius="20"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- 6) 云主体：4 圆瓣剪影，上白下浅蓝灰 -->
    <path
        android:fillType="nonZero"
        android:pathData="
            M44,50 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0
            M32,54 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0
            M37,63 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0
            M52,62 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0
        ">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="56"
                android:startY="30"
                android:endX="56"
                android:endY="78"
                android:startColor="#FFFFFF"
                android:endColor="#C9D8EA" />
        </aapt:attr>
    </path>

</vector>
