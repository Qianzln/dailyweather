<?xml version="1.0" encoding="utf-8"?>
<!-- 复刻 widget_ios：左栏城市/温度/摘要，右栏 5 日预报（图标 + 温度区间条） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:background="@drawable/widget_rounded_bg">

        <ImageView
            android:id="@+id/widget_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.42"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_ios_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#f2ffffff"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium" />

                    <ImageView
                        android:id="@+id/widget_ios_location_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/ic_widget_location"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_ios_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="46sp"
                    android:textColor="#ffffffff"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />

                <ImageView
                    android:id="@+id/widget_ios_summary_icon"
                    android:layout_width="9dp"
                    android:layout_height="15dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_widget_thermometer"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_ios_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#f2ffffff"
                    android:maxLines="3"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.58"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/widget_ios_day_row_1" style="@style/WidgetIosDayRow">
                    <TextView android:id="@+id/widget_ios_day_name_1" style="@style/WidgetIosDayName" />
                    <ImageView android:id="@+id/widget_ios_day_icon_1" style="@style/WidgetIosDayIcon" />
                    <TextView android:id="@+id/widget_ios_day_min_1" style="@style/WidgetIosDayMin" />
                    <ImageView android:id="@+id/widget_ios_day_bar_1" style="@style/WidgetIosDayBar" />
                    <TextView android:id="@+id/widget_ios_day_max_1" style="@style/WidgetIosDayMax" />
                </LinearLayout>

                <LinearLayout android:id="@+id/widget_ios_day_row_2" style="@style/WidgetIosDayRow">
                    <TextView android:id="@+id/widget_ios_day_name_2" style="@style/WidgetIosDayName" />
                    <ImageView android:id="@+id/widget_ios_day_icon_2" style="@style/WidgetIosDayIcon" />
                    <TextView android:id="@+id/widget_ios_day_min_2" style="@style/WidgetIosDayMin" />
                    <ImageView android:id="@+id/widget_ios_day_bar_2" style="@style/WidgetIosDayBar" />
                    <TextView android:id="@+id/widget_ios_day_max_2" style="@style/WidgetIosDayMax" />
                </LinearLayout>

                <LinearLayout android:id="@+id/widget_ios_day_row_3" style="@style/WidgetIosDayRow">
                    <TextView android:id="@+id/widget_ios_day_name_3" style="@style/WidgetIosDayName" />
                    <ImageView android:id="@+id/widget_ios_day_icon_3" style="@style/WidgetIosDayIcon" />
                    <TextView android:id="@+id/widget_ios_day_min_3" style="@style/WidgetIosDayMin" />
                    <ImageView android:id="@+id/widget_ios_day_bar_3" style="@style/WidgetIosDayBar" />
                    <TextView android:id="@+id/widget_ios_day_max_3" style="@style/WidgetIosDayMax" />
                </LinearLayout>

                <LinearLayout android:id="@+id/widget_ios_day_row_4" style="@style/WidgetIosDayRow">
                    <TextView android:id="@+id/widget_ios_day_name_4" style="@style/WidgetIosDayName" />
                    <ImageView android:id="@+id/widget_ios_day_icon_4" style="@style/WidgetIosDayIcon" />
                    <TextView android:id="@+id/widget_ios_day_min_4" style="@style/WidgetIosDayMin" />
                    <ImageView android:id="@+id/widget_ios_day_bar_4" style="@style/WidgetIosDayBar" />
                    <TextView android:id="@+id/widget_ios_day_max_4" style="@style/WidgetIosDayMax" />
                </LinearLayout>

                <LinearLayout android:id="@+id/widget_ios_day_row_5" style="@style/WidgetIosDayRow">
                    <TextView android:id="@+id/widget_ios_day_name_5" style="@style/WidgetIosDayName" />
                    <ImageView android:id="@+id/widget_ios_day_icon_5" style="@style/WidgetIosDayIcon" />
                    <TextView android:id="@+id/widget_ios_day_min_5" style="@style/WidgetIosDayMin" />
                    <ImageView android:id="@+id/widget_ios_day_bar_5" style="@style/WidgetIosDayBar" />
                    <TextView android:id="@+id/widget_ios_day_max_5" style="@style/WidgetIosDayMax" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
