<?xml version="1.0" encoding="utf-8"?>
<!-- 复刻 widget_small：全屏背景 + 42sp 自动缩放温度 + 34dp 图标 + 3 列逐小时 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:background="@drawable/widget_rounded_bg">

        <ImageView
            android:id="@+id/widget_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:translationX="6dp"
                android:translationY="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="42sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#eeffffff"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout style="@style/WidgetHourCell">
                <TextView android:id="@+id/widget_hour_label_1" style="@style/WidgetHourLabel" />
                <ImageView android:id="@+id/widget_hour_icon_1" style="@style/WidgetHourIcon" />
                <TextView android:id="@+id/widget_hour_temp_1" style="@style/WidgetHourTemp" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetHourCell">
                <TextView android:id="@+id/widget_hour_label_2" style="@style/WidgetHourLabel" />
                <ImageView android:id="@+id/widget_hour_icon_2" style="@style/WidgetHourIcon" />
                <TextView android:id="@+id/widget_hour_temp_2" style="@style/WidgetHourTemp" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetHourCell">
                <TextView android:id="@+id/widget_hour_label_3" style="@style/WidgetHourLabel" />
                <ImageView android:id="@+id/widget_hour_icon_3" style="@style/WidgetHourIcon" />
                <TextView android:id="@+id/widget_hour_temp_3" style="@style/WidgetHourTemp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
