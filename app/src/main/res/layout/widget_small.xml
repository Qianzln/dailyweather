<?xml version="1.0" encoding="utf-8"?>
<!-- 复刻 widget_small（南风结构）：全屏背景 + 顶部温度大字+图标+描述 + 3 行逐小时（时间|图标|温度） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:background="@drawable/widget_rounded_bg">

        <ImageView
            android:id="@+id/widget_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- 顶部：温度大字 + 图标/描述 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:translationX="6dp"
                android:translationY="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="42sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#eeffffff"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- 逐小时 3 行（南风：每行 时间 | 图标 | 温度 水平排列） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:baselineAligned="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_hour_label_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="10sp"
                    android:textColor="#bbffffff"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/widget_hour_icon_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_hour_temp_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_hour_label_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="10sp"
                    android:textColor="#bbffffff"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/widget_hour_icon_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_hour_temp_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_hour_label_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="10sp"
                    android:textColor="#bbffffff"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/widget_hour_icon_3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_hour_temp_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
