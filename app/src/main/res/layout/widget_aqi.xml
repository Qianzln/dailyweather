<?xml version="1.0" encoding="utf-8"?>
<!-- 复刻 widget_aqi（南风）：圆角背景 + 背景图 + 前景光谱图（AQI 数值/等级渲染进位图） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_aqi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/widget_aqi_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:background="@drawable/widget_rounded_bg">

        <ImageView
            android:id="@+id/widget_aqi_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_aqi_spectrum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>
